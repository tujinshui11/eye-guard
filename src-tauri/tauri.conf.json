{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "埃斯",
  "version": "0.2.2",
  "identifier": "com.tujinshui11.eyeguard",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "埃斯",
        "width": 820,
        "height": 560,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}

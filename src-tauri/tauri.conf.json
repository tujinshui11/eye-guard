{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "护眼助手",
  "version": "0.2.1",
  "identifier": "com.tujinshui11.eyeguard",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "护眼助手",
        "width": 440,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0B0F1A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
